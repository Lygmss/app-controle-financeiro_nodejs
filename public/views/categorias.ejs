<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <nav>
            <a href="/">Início</a>
            <a href="/usuarios">Usuários</a>
            <a href="/categorias">Categorias</a>
            <a href="/movimentacao">Movimentação</a>
        </nav>
        <h1>Lista de Categorias</h1>

        <% resultados.forEach(categorias => { %> 

            <p> <%= categorias.nome %> </p>

        <% }); %>

        <!-- <ul>
            <li>Alimentação</li>
            <li>Transporte</li>
            <li>Moradia</li>
        </ul> -->
      
        <button><a href="/categorias/cadastrar">Adicionar categoria</a></button>
        <button><a href="/categorias/editar-categoria">Editar categoria</a></button>
        <button><a href="/categorias/deletar-categoria">Deletar categoria</a></button>

    </div>
</body>
</html>
